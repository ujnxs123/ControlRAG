<node id="Frequency Response System">
  <data key="d0">Frequency Response System</data>
  <data key="d1">category</data>
  <data key="d2">The system described processes input signals through various blocks, including noise addition, integration, differentiation, amplification, and output.</data>
  <data key="d3">chunk-4f6dad58f78a125a7c454b0f2177f13a</data>
