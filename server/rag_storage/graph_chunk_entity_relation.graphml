  <data key="d0">Spring Constant (k1, k2)</data>
  <data key="d1">category</data>
  <data key="d2">Spring constants k1 and k2 are measures of stiffness for individual springs in a mechanical system.</data>
  <data key="d3">chunk-4af75b278219735803bd2d9c41d781d9</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
