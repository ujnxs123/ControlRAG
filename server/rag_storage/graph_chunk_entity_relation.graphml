  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Complex Conjugates">
  <data key="d0">Complex Conjugates</data>
  <data key="d1">category</data>
  <data key="d2">Complex conjugates are pairs of complex numbers that have the same real part and opposite imaginary parts, often appearing in control system pole locations.&lt;SEP&gt;Pairs of complex numbers that have the same real part and opposite imaginary parts, relevant in the context of residues.</data>
  <data key="d3">chunk-191e311819ac0dda5c8069a7a8cfa1fd&lt;SEP&gt;chunk-cf864ce976b642afda7aa4f65e82808d</data>
