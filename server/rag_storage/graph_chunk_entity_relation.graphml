  <data key="d1">category</data>
  <data key="d2">Methods used to adjust system parameters to improve stability and performance.</data>
  <data key="d3">chunk-1c56a057e86a61de468030b87f550fa4</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Resonance Frequency">
  <data key="d0">Resonance Frequency</data>
  <data key="d1">category</data>
  <data key="d2">The frequency at which a system's gain is at its peak, indicating maximum amplification.</data>
  <data key="d3">chunk-181fee5061e5d9adf0f04d196cc15e7f</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Resonant Peak Magnitude">
  <data key="d0">Resonant Peak Magnitude</data>
  <data key="d1">category</data>
  <data key="d2">Resonant Peak Magnitude indicates the peak amplitude of the system's response at resonance in the frequency domain.&lt;SEP&gt;Resonant Peak Magnitude is the maximum peak in the frequency response of a system, indicating potential resonances or oscillations.&lt;SEP&gt;The maximum overshoot in a system's transient response, correlated with the resonant peak magnitude in frequency response.&lt;SEP&gt;The maximum value of gain in a system's frequency response, indicating relative stability.</data>
  <data key="d3">chunk-50c4cfa192898028842df51ccba67794&lt;SEP&gt;chunk-ff7353abf978480820979c540d814ee3&lt;SEP&gt;chunk-181fee5061e5d9adf0f04d196cc15e7f&lt;SEP&gt;chunk-731aadaa135cc2ef1c9482aab829f4e1</data>
