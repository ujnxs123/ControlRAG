  <data key="d0">Equation (4–31)</data>
  <data key="d1">category</data>
  <data key="d2">Equation (4–31) describes the proportional relationship between oil flow rate and pilot-valve displacement.</data>
  <data key="d3">chunk-2f3d0206ddf0a9d09a9dfc373b545bef</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
