  <data key="d0">Output Y1</data>
  <data key="d1">category</data>
  <data key="d2">Output Y1 is one of the outputs from the system, influenced by the inputs through transfer functions.</data>
  <data key="d3">chunk-0f3c134e307adcb9587e648683f4f4b0</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Output Y2">
  <data key="d0">Output Y2</data>
