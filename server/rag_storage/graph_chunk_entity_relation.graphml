  <data key="d0">Spring-loaded Pendulum System</data>
  <data key="d1">category</data>
  <data key="d2">Spring-loaded Pendulum System is a mechanical system demonstrating simple harmonic motion.</data>
  <data key="d3">chunk-23de25452ffebaa5122b237d5ec13605</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
