<node id="Minor">
  <data key="d0">Minor</data>
  <data key="d1">category</data>
  <data key="d2">Minor is the determinant of a submatrix formed by deleting one row and one column from a matrix.</data>
  <data key="d3">chunk-fa799608fb083db3887d5b7460525b5b</data>
  <data key="d4">Markdown_nofigure.md</data>
