  <data key="d0">Equation 2–43</data>
  <data key="d1">category</data>
  <data key="d2">Equation 2–43 refers to a mathematical expression used to describe the behavior of a nonlinear system.</data>
  <data key="d3">chunk-80d07add21c293cc285a7efb53eea548</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Equation 2–44">
  <data key="d0">Equation 2–44</data>
  <data key="d1">category</data>
