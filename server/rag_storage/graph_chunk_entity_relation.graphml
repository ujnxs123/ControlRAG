  <data key="d0">Equation 5-28</data>
  <data key="d1">category</data>
  <data key="d2">Equation 5-28 complements Equation 5-27, contributing to the analysis of unit-impulse responses.</data>
  <data key="d3">chunk-7dee9b6b4fa01e7b310d973887043bfe</data>
