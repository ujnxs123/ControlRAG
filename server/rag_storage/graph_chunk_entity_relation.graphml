  <data key="d0">Frequency of Sustained Oscillation</data>
  <data key="d1">category</data>
  <data key="d2">The frequency at which sustained oscillation occurs in the system, calculated as ω=√5.</data>
  <data key="d3">chunk-bb690227c0aeb29078796de6d1611d85</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Period of Sustained Oscillation">
  <data key="d0">Period of Sustained Oscillation</data>
  <data key="d1">category</data>
  <data key="d2">The period of the sustained oscillation, calculated as Pcr=2π/√5.</data>
  <data key="d3">chunk-bb690227c0aeb29078796de6d1611d85</data>
  <data key="d4">Markdown_nofigure.md</data>
