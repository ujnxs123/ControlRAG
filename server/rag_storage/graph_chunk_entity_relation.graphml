  <data key="d3">chunk-f0cf05f458c91801bb85a25015c81170</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Heater">
  <data key="d0">Heater</data>
  <data key="d1">category</data>
  <data key="d2">A component within the heat exchanger responsible for warming the cold liquid.&lt;SEP&gt;The heater is a component within the heat exchanger that heats up the incoming hot fluid.&lt;SEP&gt;The heater modifies its heat output based on the control signal from the controller to affect the temperature of the cold liquid.</data>
  <data key="d3">chunk-a081030b2e96d508f9daac35a26c2be8&lt;SEP&gt;chunk-f0cf05f458c91801bb85a25015c81170&lt;SEP&gt;chunk-f1897ad76eeb7398a9874d0d8978aa7c</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Mixer">
  <data key="d0">Mixer</data>
  <data key="d1">category</data>
  <data key="d2">A component in the heat exchanger that combines warmed cold liquid with hot liquid.</data>
  <data key="d3">chunk-f0cf05f458c91801bb85a25015c81170</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Hot Liquid Output">
