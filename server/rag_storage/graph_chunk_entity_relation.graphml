  <data key="d0">Pendulum Rod</data>
  <data key="d1">category</data>
  <data key="d2">The pendulum rod is part of the inverted pendulum system, with its center of gravity affecting rotational motion.</data>
  <data key="d3">chunk-a7d35d4c0a78082736add717b2833c58</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Attitude Control">
  <data key="d0">Attitude Control</data>
  <data key="d1">category</data>
  <data key="d2">Attitude control refers to the process of keeping the space booster in a vertical position during takeoff.</data>
  <data key="d3">chunk-a7d35d4c0a78082736add717b2833c58</data>
