<node id="Transfer Function 1">
  <data key="d0">Transfer Function 1</data>
  <data key="d1">category</data>
  <data key="d2">Transfer Function 1 is defined as [1 s+2]/[s^3 + 4*s^2 + 5*s + 6], used to generate the unit-step response of the first system.</data>
