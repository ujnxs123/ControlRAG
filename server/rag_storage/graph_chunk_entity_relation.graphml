  <data key="d0">Critical Gain (K_cr)</data>
  <data key="d1">category</data>
  <data key="d2">Critical Gain (K_cr) is a parameter used in control systems to define the gain at which sustained oscillations occur.</data>
  <data key="d3">chunk-0bfe9ed85a05514b41c868536d544660</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
<node id="Critical Period (P_cr)">
  <data key="d0">Critical Period (P_cr)</data>
  <data key="d1">category</data>
  <data key="d2">Critical Period (P_cr) is the time period associated with sustained oscillations in a control system, used in tuning rules.</data>
  <data key="d3">chunk-0bfe9ed85a05514b41c868536d544660</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
