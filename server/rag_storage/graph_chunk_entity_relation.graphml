  <data key="d7">signal interaction, system dynamics&lt;SEP&gt;system stability, control regulation</data>
  <data key="d8">chunk-5f3d1f90ecef2ea0c231698609f06418&lt;SEP&gt;chunk-9571f0c498fec38011c9f30cf7ab85ab</data>
