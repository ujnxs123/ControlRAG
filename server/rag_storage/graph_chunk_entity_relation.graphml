</node>
<node id="e(s)">
  <data key="d0">e(s)</data>
  <data key="d1">category</data>
  <data key="d2">e(s) is the error signal in a control system, calculated as the difference between the reference input and the controlled variable.</data>
  <data key="d3">chunk-f87ef3fd6a4c1856d15e4ad169e98183</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
