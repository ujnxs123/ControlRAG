  <data key="d0">Figure 5-11</data>
  <data key="d1">category</data>
  <data key="d2">Figure 5-11 shows curves of settling time versus damping ratio for different tolerance criteria.</data>
  <data key="d3">chunk-d293ccd91839b1545fb3a78b69f822a2</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
