  <data key="d0">Nonsingular Matrix P</data>
  <data key="d1">category</data>
  <data key="d2">Nonsingular Matrix P is a matrix used to relate system states, important for ensuring that the system's initial state can be determined.</data>
  <data key="d3">chunk-36f2caf127ba71d0e038dc68e38f26ca</data>
