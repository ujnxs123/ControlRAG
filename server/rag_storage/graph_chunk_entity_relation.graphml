  <data key="d9">Markdown_nofigure.md</data>
</edge>
<edge source="Proportional Control" target="Control Algorithm">
  <data key="d5">6.0</data>
  <data key="d6">The control algorithm in a proportional control system processes input signals to generate output signals, aiming to reduce error.</data>
