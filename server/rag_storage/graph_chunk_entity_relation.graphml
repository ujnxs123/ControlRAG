  <data key="d0">Equation (6–7)</data>
  <data key="d1">category</data>
  <data key="d2">Equation (6–7) is used to identify points where multiple roots of the characteristic equation occur.</data>
  <data key="d3">chunk-6a89464a87dc57e95afa0a980ba9d6c0</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
