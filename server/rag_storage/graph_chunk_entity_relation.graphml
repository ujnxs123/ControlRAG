  <data key="d0">Input System</data>
  <data key="d1">category</data>
  <data key="d2">Input system refers to the arrangement of inputs in the state-space equations used for transfer function calculations.</data>
  <data key="d3">chunk-f2bf8d3735dca25672b127e3b08be5b7</data>
