</node>
<node id="Matrix CP">
  <data key="d0">Matrix CP</data>
  <data key="d1">category</data>
  <data key="d2">Matrix CP is a mathematical construct used to determine system observability, ensuring that no column consists entirely of zero elements.</data>
  <data key="d3">chunk-36f2caf127ba71d0e038dc68e38f26ca</data>
  <data key="d4">Markdown_nofigure.md</data>
