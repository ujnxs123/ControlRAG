  <data key="d1">category</data>
  <data key="d2">The graph illustrates the relationship between settling time and tolerance band, showing different lines for various percentage values.</data>
  <data key="d3">chunk-d293ccd91839b1545fb3a78b69f822a2</data>
  <data key="d4">Markdown_nofigure.md</data>
</node>
