  <data key="d8">chunk-620d81e2a5a2e80e3b426e6ed3a7d42b</data>
  <data key="d9">Markdown_nofigure.md</data>
</edge>
<edge source="Proportional Controller" target="Torque Disturbance">
  <data key="d5">9.0</data>
  <data key="d6">The Proportional Controller counteracts the Torque Disturbance by providing equal and opposite torque.</data>
  <data key="d7">compensation, control</data>
  <data key="d8">chunk-204365918a7a13528bbf287196b97d31</data>
  <data key="d9">Markdown_nofigure.md</data>
</edge>
<edge source="Proportional Controller" target="Derivative Controller">
  <data key="d5">8.0</data>
  <data key="d6">The derivative controller complements the proportional controller by anticipating errors and enhancing system stability.</data>
  <data key="d7">control enhancement, error anticipation</data>
  <data key="d8">chunk-cd437ba37843beb72e13fcc99049d49c</data>
  <data key="d9">Markdown_nofigure.md</data>
</edge>
<edge source="Proportional Controller" target="Kp">
  <data key="d5">8.0</data>
