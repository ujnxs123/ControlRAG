# ControlRAG local configuration template. Contains no real credentials.
# Copy this file to server/.env, then run lightrag-server from server/.
HOST=127.0.0.1
PORT=9621
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs
WEBUI_TITLE=ControlRAG
WEBUI_DESCRIPTION=Automatic Control Knowledge Assistant

# Replace model names, URLs and keys with your own provider settings.
LLM_BINDING=openai
LLM_MODEL=your-chat-model
LLM_BINDING_HOST=https://api.example.com/v1
LLM_BINDING_API_KEY=your-chat-api-key
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BINDING_HOST=https://api.example.com/v1
EMBEDDING_BINDING_API_KEY=your-embedding-api-key
# Example only: this MUST equal the embedding model's output dimension.
EMBEDDING_DIM=1536

SUMMARY_LANGUAGE=English
TIMEOUT=150
MAX_ASYNC=4
MAX_TOKENS=32768
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
